{
	"name": "xwright-monorepo",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.14.0",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"build": "tsc -b && pnpm --filter @xwright/ui build",
