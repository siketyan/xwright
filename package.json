		"changeset": "changeset"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@changesets/changelog-github": "1.0.1",
		"@changesets/cli": "3.0.3",
		"@types/node": "^26.6.5",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	}
}
